{
  "name": "@usebruno/api-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./hooks": "./src/hooks/index.ts",
    "./constants": "./src/constants/index.ts",
    "./routing": "./src/routing/index.ts",
    "./ui/MenuDropdown": "./src/ui/MenuDropdown/index.ts",
    "./assets/icons": "./src/assets/icons/index.ts",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "gen:theme": "vite-node scripts/generate-theme-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  }
}
