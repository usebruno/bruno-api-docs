{
  "name": "@usebruno/api-docs",
  "version": "0.6.0",
  "description": "Interactive API documentation component for OpenCollection - supports both React components and standalone JavaScript",
  "type": "module",
  "main": "dist/oc-playground.umd.js",
  "module": "dist/oc-playground.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/oc-playground.es.js",
      "require": "./dist/oc-playground.umd.js"
    },
    "./standalone": {
      "types": "./standalone.d.ts",
      "import": "./dist-standalone/playground.es.js",
      "require": "./dist-standalone/playground.umd.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "dist-standalone",
    "standalone.d.ts"
  ],
  "scripts": {
    "gen:theme": "npm run gen:theme -w @usebruno/api-shared",
    "predev": "npm run gen:theme && npm run build:lib-bundle",
    "dev": "vite",
    "server": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build:lib-bundle": "npm run build:lib-bundle -w @usebruno/api-playground",
    "prebuild": "npm run gen:theme && npm run build:lib-bundle",
    "build": "npm run clean && tsc -p tsconfig.build.json --noEmit && vite build",
    "build:standalone": "npm run clean:standalone && npm run build:cdn -w @usebruno/api-playground && vite build --config vite.config.standalone.ts",
    "build:all": "npm run build && npm run build:standalone",
    "prepublishOnly": "npm run build:all",
    "preview": "vite preview",
    "pretest": "npm run build:lib-bundle",
    "test": "vitest",
    "pretest:run": "npm run build:lib-bundle",
    "test:run": "vitest run",
    "test:e2e": "playwright test; a=$?; playwright test -c playwright.standalone.config.ts || exit 1; exit $a",
    "test:e2e:standalone": "playwright test -c playwright.standalone.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rimraf dist",
    "clean:standalone": "rimraf dist-standalone"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@opencollection/types": "0.15.0",
    "@types/js-yaml": "^4.0.9",
    "@usebruno/api-playground": "*",
    "@usebruno/api-shared": "*",
    "fuse.js": "^7.5.0",
    "js-yaml": "^4.1.0",
    "lodash-es": "~4.17.21",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "~11.13.5",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/lodash-es": "~4.17.12",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "buffer": "^6.0.3",
    "concurrently": "^9.1.2",
    "node-html-parser": "^8.0.4",
    "postcss": "^8.5.3",
    "prismjs": "^1.29.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.2",
    "tailwindcss": "^4.0.9",
    "terser": "^5.44.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "keywords": [
    "opencollection",
    "api",
    "documentation",
    "playground",
    "interactive"
  ],
  "author": "OpenCollection",
  "license": "MIT"
}
