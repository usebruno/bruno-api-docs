# Baseline every editor honours. The ESLint stylistic rules in eslint.config.mjs
# are the real authority — these just stop an editor fighting them before lint runs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
